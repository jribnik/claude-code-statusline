{
  "manifest_version": 3,
  "name": "Status Line for Claude Code Web (unofficial)",
  "version": "0.1.0",
  "description": "Unofficial, best-effort CLI-style status bar for Claude Code on the web. Not affiliated with or endorsed by Anthropic.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "host_permissions": ["https://claude.ai/*"],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["src/shared/selector-pack.js", "src/main-world/interceptor.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["src/shared/config.js", "src/shared/render.js", "src/isolated/content.js"],
      "world": "ISOLATED",
      "run_at": "document_start"
    }
  ]
}
